# PostgreSQL connection (default port is 5432)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# If your password contains special characters (@ : / #), URL-encode them.
DATABASE_URL="postgresql://cartnova:change_me_dev_only@localhost:5432/cartnova?schema=public"

# Dummy password used ONLY for the demo seed user (development only)
SEED_DEMO_PASSWORD="ChangeMe-Dev-Only"
